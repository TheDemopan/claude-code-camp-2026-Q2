import socket
import os
import time
import threading

MUD_HOST = 'localhost'
MUD_PORT = 4000
USER = 'dummy'
PASSWORD = 'helloworld'
UNIX_SOCKET_PATH = '/tmp/tbaMUD.sock'

class MUDServer:
    def __init__(self):
        self.mud_socket = None
        self.is_running = True
        self.lock = threading.Lock()

    def connect_to_mud(self):
        print(f"Connecting to MUD at {MUD_HOST}:{MUD_PORT}...")
        self.mud_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        self.mud_socket.connect((MUD_HOST, MUD_PORT))
        self.mud_socket.settimeout(5.0)

        # Login process
        try:
            # Initial read to find prompt
            buf = b""
            start_time = time.time()
            while time.time()_start_time < 5.0:
                try:
                    data = self.mud_socket.recv(4096)
                    if not data: break
                    buf += data
                    if b"Username:" in buf or b"Password:" in buf:
                        break
                except socket.timeout:
                    break

            print(f"Auth step 1: {buf.decode('utf-8', errors='ignore')}")
            self.mud_socket.sendall((USER + "\n").encode())

            time.sleep(1.0)
            buf = self.mud_socket.recv(4096)
            print(f"Auth step 2: {buf.decode('utf-8', errors='ignore')}")
            self.mud_socket.sendall((PASSWORD + "\n").encode())
            time.sleep(1.0)
            buf = self.mud_socket.recv(4096)
            print(f"Auth step 3: {buf.decode('utf-8', errors='ignore')}")

        except Exception as e:
            print(f"Login error: {e}")

    def handle_client(self, client_conn, addr):
        print(f"Client connected from {addr}")
        try:
            while True:
                command = client_conn.recv(4096).decode('utf-8', errors='ignore').strip()
                if not command:
                    break

                print(f"Forwarding command to MUD: {command}")
                with self.lock:
                    self.mud_socket.sendall((command + "\n").encode())
                    time.sleep(1.5) # Wait for response

                    # Read response from MUD
                    response = b""
                    self.mud_socket.settimeout(2.0)
                    try:
                        data = self.mud_socket.recv(4096)
                        if data:
                            response = data
                    except socket.timeout:
                        pass

                    client_conn.sendall(response if response else b"No response from MUD\n")

        except Exception as e:
            print(f"Client handler error: {e}")
        finally:
            client_conn.close()

    def run(self):
        if os.path.exists(UNIX_SOCKET_PATH):
            os.remove(UNIX_SOCKET_PATH)

        self.connect_to_mud()

        server_sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        server_sock.bind(UNIX_SOCKET_PATH)
        server_sock.listen(5)
        print(f"Server listening on {UNIX_SOCKET_PATH}")

        try:
            while self.is_running:
                conn, addr = server_sock.accept()
                client_thread = threading.Thread(target=self.handle_client, args=(conn, addr))
                client_thread.daemon = True
                client_thread.start()
        except Exception as e:
            print(f"Server loop error: {e}")
        finally:
            server_sock.close()
            if os.path.exists(UNIX_SOCKET_PATH):
                os.remove(UNIX_SOCKET_PATH)

if __name__ == "__main__":
    # In a real implementation, I'd handle shutdown/cleanup better
    server = MUDServer()
    server.run()
